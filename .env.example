# LA SHAUNNIE only. All merchant secrets stay in this site's Vercel settings.
LA_CARD_ENABLED=false
LA_NEWEBPAY_APPROVED_STORE=false
LA_NEWEBPAY_MERCHANT_ID=
LA_NEWEBPAY_HASH_KEY=
LA_NEWEBPAY_HASH_IV=
LA_NEWEBPAY_MODE=test
LA_PUBLIC_URL=
LA_TWD_PER_USD=

# LA retail: US$45/bottle; 1 bottle international shipping US$6; 2+ free.
# Carrier postage estimates are for internal cost comparison, not buyer charges.
# Starting packed weight is only an estimate (200 grams); measure one packed order.
LA_PACKED_WEIGHT_GRAMS=200

# Optional verified SF Express quote in TWD for same packed parcel.
# Enter only a genuine current SF quote and its validity date.
LA_SF_QUOTE_TWD_VN=
LA_SF_QUOTE_TWD_SG=
LA_SF_QUOTE_TWD_MY=
LA_SF_QUOTE_TWD_ID=
LA_SF_QUOTE_TWD_HK=
LA_SF_QUOTE_VALID_THROUGH=

# Optional Taiwan DOMESTIC shipping TWD (not covered by overseas ePacket).
LA_TW_SHIPPING_TWD=

# Existing LA Airtable order integration.
AIRTABLE_TOKEN=
